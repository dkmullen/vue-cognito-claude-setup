# Copy to .env and fill in. Vite exposes only VITE_-prefixed variables to the app.

# Backend API base URL (src/lib/http.js)
VITE_API_BASE_URL=http://localhost:3000/api

# AWS Cognito user pool (src/lib/cognito.js).
# The region is read from the user pool ID (e.g. us-east-1_AbCdEf123), so no
# separate region variable is needed.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
